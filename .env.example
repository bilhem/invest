# CRM webhook: receives every consultation request and Lab sign-up as JSON { kind: 'consultation' | 'lab', ... }
# REQUIRED in production, otherwise form submissions return an error on purpose (no silent lead loss).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Scheduling embed shown after the consultation form (Calendly, Cal.com… embed URL)
NEXT_PUBLIC_BOOKING_URL=

# Analytics: loaded only after the visitor accepts cookies. Leave empty to disable (and hide the banner).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
