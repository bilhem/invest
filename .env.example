# CRM webhook: receives every consultation request and Lab sign-up as JSON { kind: 'consultation' | 'lab', ... }
# Consultation payload: submission_id (de-duplicate on it), phone in E.164, consent_text / consent_version / consent_received_at, utm_*...
# REQUIRED in production, otherwise form submissions return an error on purpose (no silent lead loss) and the booking step never opens.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Scheduling page shown AFTER the lead is saved. Optional: defaults to https://calendly.com/bilel-hemissi/new-meeting (lib/booking.ts).
# Set it to use another Calendly event or Cal.com. Name and email are pre-filled for Calendly URLs only.
NEXT_PUBLIC_BOOKING_URL=

# Analytics: loaded only after the visitor accepts cookies. Leave empty to disable (and hide the banner).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Show the name of each missing image on placeholders (always on in development). Set to 1 on a preview deploy; never in production.
NEXT_PUBLIC_SHOW_IMAGE_SLOTS=
